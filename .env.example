# SatQuery root environment example.
# Copy to .env for Docker Compose and FastAPI. The backend resolves this exact
# root path; it does not search parent directories. Values below are local-only
# examples, not production credentials. Replace passwords and keys in your local file.

# ==============================================================================
# A. Application settings
# ==============================================================================
SATQUERY_APP_NAME="SatQuery AI"
SATQUERY_ENV=development
SATQUERY_DEBUG=false
SATQUERY_CONTRACT_VERSION=1.0
SATQUERY_LOG_LEVEL=INFO
SATQUERY_API_PREFIX=/api/v1
FRONTEND_CORS_ORIGINS=["http://localhost:3000"]

# ==============================================================================
# B. Database settings (PostgreSQL/PostGIS)
# ==============================================================================
POSTGRES_DB=satquery
POSTGRES_USER=satquery
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://satquery:change_this_local_password@127.0.0.1:5432/satquery
DB_CONNECT_TIMEOUT_SECONDS=3
DB_HEALTH_TIMEOUT_SECONDS=5
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10

# ==============================================================================
# C. Satellite imagery provider settings
# ==============================================================================
# Provider selection: earth-search | sentinel_hub | copernicus_dataspace | planetary_computer | mock
SATQUERY_SATELLITE_PROVIDER=earth-search
# Provider mode: mock | real | disabled
SATQUERY_SATELLITE_PROVIDER_MODE=real
SATQUERY_SATELLITE_BASE_URL=https://earth-search.aws.element84.com/v1/
SATQUERY_SATELLITE_CLIENT_ID=
SATQUERY_SATELLITE_CLIENT_SECRET=
SATQUERY_SATELLITE_ACCESS_TOKEN=
SATQUERY_SATELLITE_TIMEOUT_SECONDS=10.0
SATQUERY_SATELLITE_MAX_RETRIES=2
SATQUERY_DEFAULT_COLLECTION=sentinel-2-c1-l2a
SATQUERY_DEFAULT_CLOUD_COVER=20.0
SATQUERY_MAX_CATALOG_RESULTS=50
SATQUERY_MAX_AOI_SQUARE_KM=10000.0

# Legacy Earth Search STAC settings
CATALOGUE_PROVIDER=earth-search
EARTH_SEARCH_BASE_URL=https://earth-search.aws.element84.com/v1/
EARTH_SEARCH_TIMEOUT_SECONDS=10
EARTH_SEARCH_MAX_RETRIES=2
EARTH_SEARCH_CACHE_TTL_SECONDS=300
# ==============================================================================
# D. Imagery and raster retrieval settings
# ==============================================================================
IMAGERY_TILE_MAX_ZOOM=16
IMAGERY_TILE_REQUEST_TIMEOUT_SECONDS=30
IMAGERY_TILE_MAX_CONCURRENCY=2
IMAGERY_TILE_SET_TTL_SECONDS=300
IMAGERY_TILE_SET_CACHE_MAX_ENTRIES=32
IMAGERY_TILE_BYTE_CACHE_MAX_BYTES=16777216
IMAGERY_MAX_PREVIEW_WIDTH=2048
IMAGERY_MAX_PREVIEW_HEIGHT=2048
IMAGERY_MAX_PREVIEW_PIXELS=4194304
IMAGERY_MAX_ANALYSIS_RASTER_PIXELS=16777216
IMAGERY_MAX_FILE_SIZE_BYTES=52428800
IMAGERY_MIN_ALLOWED_RESOLUTION_METERS=1.0
IMAGERY_MAX_ALLOWED_RESOLUTION_METERS=1000.0
IMAGERY_ASSET_CACHE_TTL_SECONDS=1800
IMAGERY_STORAGE_DIR=data/imagery_cache

# ==============================================================================
# E. AI / VLM provider settings
# ==============================================================================
# Provider selection: gemini | openai | mock | disabled
SATQUERY_AI_PROVIDER=gemini
# Provider mode: mock | real | disabled
SATQUERY_AI_PROVIDER_MODE=mock
SATQUERY_AI_BASE_URL=
SATQUERY_AI_API_KEY=
SATQUERY_AI_MODEL=gemini-2.0-flash
SATQUERY_AI_TIMEOUT_SECONDS=30.0
SATQUERY_AI_MAX_RETRIES=2
SATQUERY_AI_ENABLED=true

# ==============================================================================
# F. Processing & Demo / Fallback settings
# ==============================================================================
# Processing mode: standard | fast | deep
SATQUERY_PROCESSING_MODE=standard
SATQUERY_MAX_CONCURRENT_JOBS=4
SATQUERY_DEFAULT_RESOLUTION_METERS=10.0
SATQUERY_OVERLAY_GENERATION_ENABLED=true
SATQUERY_REPORT_GENERATION_ENABLED=true
SATQUERY_DEMO_MODE=false
SATQUERY_ALLOW_MOCK_FALLBACK=true
SATQUERY_MOCK_LATENCY_MS=0

# ==============================================================================
# G. Frontend public variables (prefix NEXT_PUBLIC_ for Next.js browser bundle)
# Never place credentials or API keys in these variables!
# ==============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_CONTRACT_VERSION=1.0
NEXT_PUBLIC_DEMO_MODE=false

# ==============================================================================
# H. Isolated integration test database profile
# ==============================================================================
TEST_POSTGRES_PORT=55432
TEST_POSTGRES_PASSWORD=satquery_test_only
SATQUERY_TEST_DATABASE_URL=postgresql+psycopg://satquery_test:satquery_test_only@127.0.0.1:55432/satquery_test

