# SatQuery root environment example.
# Copy to .env for Docker Compose and FastAPI. The backend resolves this exact
# root path; it does not search parent directories. Values below are local-only
# examples, not production credentials. Replace the password in your local file.

# PostgreSQL/PostGIS container and backend connection (server-only)
POSTGRES_DB=satquery
POSTGRES_USER=satquery
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://satquery:change_this_local_password@127.0.0.1:5432/satquery

# FastAPI configuration (server-only)
SATQUERY_ENV=development
SATQUERY_LOG_LEVEL=INFO
SATQUERY_API_PREFIX=/api/v1
FRONTEND_CORS_ORIGINS=["http://localhost:3000"]
DB_CONNECT_TIMEOUT_SECONDS=3
DB_HEALTH_TIMEOUT_SECONDS=5
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10

# Earth Search STAC catalogue (server-only, metadata requests only)
CATALOGUE_PROVIDER=earth-search
EARTH_SEARCH_BASE_URL=https://earth-search.aws.element84.com/v1/
EARTH_SEARCH_TIMEOUT_SECONDS=10
EARTH_SEARCH_MAX_RETRIES=2
EARTH_SEARCH_CACHE_TTL_SECONDS=300
EARTH_SEARCH_CACHE_MAX_ENTRIES=32

# Bounded server-side imagery tile delivery (public Earth Search visualization only)
IMAGERY_TILE_MAX_ZOOM=16
IMAGERY_TILE_REQUEST_TIMEOUT_SECONDS=30
IMAGERY_TILE_MAX_CONCURRENCY=2
IMAGERY_TILE_SET_TTL_SECONDS=300
IMAGERY_TILE_SET_CACHE_MAX_ENTRIES=32
IMAGERY_TILE_BYTE_CACHE_MAX_BYTES=16777216

# Bounded preparation jobs and private local artifact backend (server-only)
PROCESSING_ARTIFACT_ROOT=.satquery-artifacts
# Operator-staged NISAR HDF5 files; Earthdata credentials stay outside SatQuery.
NISAR_PRODUCT_CACHE_ROOT=.satquery-nisar-products
PROCESSING_MAX_CONCURRENCY=1
PROCESSING_TIMEOUT_SECONDS=300
PROCESSING_MAX_PIXELS=4000000
PROCESSING_MAX_MEMORY_BYTES=536870912
PROCESSING_MAX_ARTIFACT_BYTES=536870912

# Isolated integration database profile (local test values only)
TEST_POSTGRES_PORT=55432
TEST_POSTGRES_PASSWORD=satquery_test_only
SATQUERY_TEST_DATABASE_URL=postgresql+psycopg://satquery_test:satquery_test_only@127.0.0.1:55432/satquery_test

# LATER PHASES — optional and unused in Phase 1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=900

# SERVER-ONLY AUTHENTICATION (provider and scheme remain unresolved)
AUTH_ISSUER_URL=
AUTH_AUDIENCE=

# OPTIONAL EO PROVIDER CREDENTIALS (unused by the public Earth Search adapter)
EO_PROVIDER_CLIENT_ID=
EO_PROVIDER_CLIENT_SECRET=

# OPTIONAL RUNTIME AI SERVICE (not the Codex development model)
# For xAI image questions, set RUNTIME_AI_PROVIDER=xai, RUNTIME_AI_MODEL=grok-4.3,
# and XAI_API_KEY only in the repository-root .env or backend process environment.
# The OpenAI option continues to use RUNTIME_AI_API_KEY instead.
RUNTIME_AI_PROVIDER=
RUNTIME_AI_API_KEY=
XAI_API_KEY=
RUNTIME_AI_MODEL=
RUNTIME_AI_TIMEOUT_SECONDS=60
RUNTIME_AI_MAX_CONCURRENCY=1
RUNTIME_AI_MAX_OUTPUT_TOKENS=300

# OPTIONAL BACKGROUND-JOB BACKEND (implementation remains unresolved)
JOB_BACKEND_URL=
