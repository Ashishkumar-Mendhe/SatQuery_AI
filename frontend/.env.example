# Public browser configuration. Next.js loads the copied .env.local from this
# frontend directory. NEXT_PUBLIC values are included in browser bundles.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# OpenFreeMap Liberty is the default basemap. Keep secret-bearing providers server-side.
NEXT_PUBLIC_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_BASEMAP_NAME=OpenFreeMap Liberty
# Optional HTTPS, CORS-enabled, Nominatim-compatible provider that permits browser
# queries. No public Nominatim default: its application-wide limit needs a proxy.
NEXT_PUBLIC_GEOCODER_URL=
NEXT_PUBLIC_GEOCODER_NAME=
